<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:simpleType name="NonEmptyText">
    <xs:restriction base="xs:token"><xs:minLength value="1" /><xs:maxLength value="8192" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ShortLabel">
    <xs:restriction base="xs:token"><xs:minLength value="1" /><xs:maxLength value="64" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DisplayLabel">
    <xs:restriction base="xs:token"><xs:minLength value="1" /><xs:maxLength value="128" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DescriptionText">
    <xs:restriction base="xs:token"><xs:minLength value="1" /><xs:maxLength value="4096" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SkillId">
    <xs:restriction base="xs:token"><xs:pattern value="[a-z0-9][a-z0-9-]*" /><xs:maxLength value="64" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="HttpsUrl">
    <xs:restriction base="xs:anyURI"><xs:pattern value="https://.+" /><xs:maxLength value="2048" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="GitHubRepository">
    <xs:restriction base="xs:anyURI"><xs:pattern value="https://github\.com/[A-Za-z0-9_-][A-Za-z0-9_.-]*/[A-Za-z0-9_-][A-Za-z0-9_.-]*" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RepositoryPath">
    <xs:restriction base="xs:token"><xs:pattern value="\.|[A-Za-z0-9_-]([A-Za-z0-9_.-]*[A-Za-z0-9_-])?(/[A-Za-z0-9_-]([A-Za-z0-9_.-]*[A-Za-z0-9_-])?)*" /><xs:maxLength value="160" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CommitRef">
    <xs:restriction base="xs:token"><xs:pattern value="[0-9a-fA-F]{40}" /><xs:length value="40" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NetworkRequirement">
    <xs:restriction base="xs:token"><xs:enumeration value="required" /><xs:enumeration value="optional" /><xs:enumeration value="none" /></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="InstallMode">
    <xs:restriction base="xs:token"><xs:enumeration value="upstream" /></xs:restriction>
  </xs:simpleType>
  <xs:element name="SkillCatalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Skill" minOccurs="0" maxOccurs="256">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Description" type="DescriptionText" />
              <xs:element name="Source">
                <xs:complexType>
                  <xs:attribute name="Repository" type="GitHubRepository" use="required" />
                  <xs:attribute name="Path" type="RepositoryPath" use="required" />
                  <xs:attribute name="Ref" type="CommitRef" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Author" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="Name" type="DisplayLabel" use="required" />
                  <xs:attribute name="Url" type="HttpsUrl" use="optional" />
                </xs:complexType>
              </xs:element>
              <xs:element name="License">
                <xs:complexType>
                  <xs:attribute name="SPDX" type="DisplayLabel" use="required" />
                  <xs:attribute name="Source" type="HttpsUrl" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Requirements">
                <xs:complexType>
                  <xs:attribute name="Runtime" type="xs:token" use="required" fixed="Codex" />
                  <xs:attribute name="Network" type="NetworkRequirement" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Install">
                <xs:complexType>
                  <xs:attribute name="Mode" type="InstallMode" use="required" />
                </xs:complexType>
              </xs:element>
              <xs:element name="Notes" type="NonEmptyText" minOccurs="0" />
            </xs:sequence>
            <xs:attribute name="Id" type="SkillId" use="required" />
            <xs:attribute name="Category" type="ShortLabel" use="required" />
            <xs:attribute name="DisplayName" type="DisplayLabel" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="Version" type="xs:positiveInteger" use="required" fixed="1" />
    </xs:complexType>
    <xs:unique name="UniqueSkillId"><xs:selector xpath="Skill" /><xs:field xpath="@Id" /></xs:unique>
  </xs:element>
</xs:schema>

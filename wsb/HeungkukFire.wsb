<?xml version='1.0' encoding='utf-8'?>
<Configuration>
  <!--Generated from the TableCloth catalog. Runs installers only inside the Windows guest.-->
  <VGpu>Disable</VGpu>
  <Networking>Enable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ProtectedClient>Enable</ProtectedClient>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <LogonCommand>
    <Command>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$m=New-Object IO.MemoryStream(,[Convert]::FromBase64String(''));$z=New-Object IO.Compression.GZipStream($m,[IO.Compression.CompressionMode]::Decompress);$r=New-Object IO.StreamReader($z,[Text.Encoding]::UTF8);$TableClothGuestSource=$r.ReadToEnd();try{&amp; ([scriptblock]::Create($TableClothGuestSource))}finally{$r.Dispose();$m.Dispose()}"</Command>
  </LogonCommand>
</Configuration>
